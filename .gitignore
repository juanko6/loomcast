# Python
__pycache__/
*.pyc
.venv/
venv/
fase0/venv/

# Herramientas y binarios descargados
# Anclados a la raíz (con /) para que NO oculten directorios homónimos del
# frontend, p.ej. web/src/components/musica|galeria — Tailwind respeta .gitignore
# y un patrón sin ancla ("musica/") esconde esas carpetas de su escaneo.
/tools/

# Salidas generadas (todas en la raíz del proyecto, por eso van ancladas)
/logs/
fase0/rife_test/
fase0/*.wav
/proyectos/
/galeria/
/musica/
/pruebas_i2v/
*.db
# Videos de referencia (pesan ~100 MB; son material de consulta, no fuente)
referencias/*.mp4

# macOS
.DS_Store
/voces/
/reparto/

# Frontend Astro (Loomcast Studio)
web/node_modules/
web/dist/
web/.astro/

# Tests
.coverage
.pytest_cache/
web/coverage/

# Referencias sacadas de YouTube (material de consulta personal, no se publica)
/referencias/youtube/
