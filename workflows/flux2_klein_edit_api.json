{
  "unet": {
    "class_type": "UnetLoaderGGUF",
    "inputs": { "unet_name": "flux-2-klein-9b-Q8_0.gguf" }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_8b_fp4mixed.safetensors",
      "type": "flux2",
      "device": "cpu"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "flux2-vae.safetensors" }
  },
  "load": {
    "class_type": "LoadImage",
    "inputs": { "image": "{IMAGE}" }
  },
  "scale": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": ["load", 0],
      "upscale_method": "lanczos",
      "megapixels": 1.0,
      "resolution_steps": 16
    }
  },
  "size": {
    "class_type": "GetImageSize",
    "inputs": { "image": ["scale", 0] }
  },
  "ref_latent": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["scale", 0], "vae": ["vae", 0] }
  },
  "texto": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["clip", 0], "text": "{PROMPT}" }
  },
  "positive": {
    "class_type": "ReferenceLatent",
    "inputs": { "conditioning": ["texto", 0], "latent": ["ref_latent", 0] }
  },
  "zero": {
    "class_type": "ConditioningZeroOut",
    "inputs": { "conditioning": ["texto", 0] }
  },
  "negative": {
    "class_type": "ReferenceLatent",
    "inputs": { "conditioning": ["zero", 0], "latent": ["ref_latent", 0] }
  },
  "latent": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": { "width": ["size", 0], "height": ["size", 1], "batch_size": 1 }
  },
  "sigmas": {
    "class_type": "Flux2Scheduler",
    "inputs": { "steps": 4, "width": ["size", 0], "height": ["size", 1] }
  },
  "guider": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": ["unet", 0],
      "positive": ["positive", 0],
      "negative": ["negative", 0],
      "cfg": 1.0
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": "{SEED}" }
  },
  "sampler_select": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "euler" }
  },
  "sampler": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["noise", 0],
      "guider": ["guider", 0],
      "sampler": ["sampler_select", 0],
      "sigmas": ["sigmas", 0],
      "latent_image": ["latent", 0]
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["sampler", 0], "vae": ["vae", 0] }
  },
  "save": {
    "class_type": "PreviewImage",
    "inputs": { "images": ["decode", 0] }
  }
}
