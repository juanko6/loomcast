{
  "unet": {
    "class_type": "UnetLoaderGGUF",
    "inputs": {
      "unet_name": "hunyuanvideo1.5_480p_i2v_cfg_distilled-Q8_0.gguf"
    }
  },
  "clip": {
    "class_type": "DualClipLoaderGGUF",
    "inputs": {
      "clip_name1": "qwen2.5-vl-7b-test-q4_0.gguf",
      "clip_name2": "byt5_small_glyphxl_fp16.safetensors",
      "type": "hunyuan_video_15",
      "device": "default"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "hunyuanvideo15_vae_fp16.safetensors" }
  },
  "clipvision": {
    "class_type": "CLIPVisionLoader",
    "inputs": { "clip_name": "sigclip_vision_patch14_384.safetensors" }
  },
  "load": {
    "class_type": "LoadImage",
    "inputs": { "image": "{IMAGE}" }
  },
  "cvenc": {
    "class_type": "CLIPVisionEncode",
    "inputs": {
      "clip_vision": ["clipvision", 0],
      "image": ["load", 0],
      "crop": "center"
    }
  },
  "positive": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{PROMPT}", "clip": ["clip", 0] }
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "", "clip": ["clip", 0] }
  },
  "i2v": {
    "class_type": "HunyuanVideo15ImageToVideo",
    "inputs": {
      "positive": ["positive", 0],
      "negative": ["negative", 0],
      "vae": ["vae", 0],
      "width": 480,
      "height": 848,
      "length": "{FRAMES}",
      "batch_size": 1,
      "start_image": ["load", 0],
      "clip_vision_output": ["cvenc", 0]
    }
  },
  "shift": {
    "class_type": "ModelSamplingSD3",
    "inputs": { "model": ["unet", 0], "shift": 7.0 }
  },
  "sampler_sel": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "euler" }
  },
  "sched": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["shift", 0],
      "scheduler": "simple",
      "steps": 8,
      "denoise": 1.0
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": "{SEED}" }
  },
  "guider": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": ["shift", 0],
      "positive": ["i2v", 0],
      "negative": ["i2v", 1],
      "cfg": 1.0
    }
  },
  "adv": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["noise", 0],
      "guider": ["guider", 0],
      "sampler": ["sampler_sel", 0],
      "sigmas": ["sched", 0],
      "latent_image": ["i2v", 2]
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["adv", 0], "vae": ["vae", 0] }
  },
  "create": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["decode", 0], "fps": 24 }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["create", 0],
      "filename_prefix": "loomcast/i2v",
      "format": "auto",
      "codec": "h264"
    }
  }
}
