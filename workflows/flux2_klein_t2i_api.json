{
  "unet": {
    "class_type": "UnetLoaderGGUF",
    "inputs": { "unet_name": "flux-2-klein-9b-Q8_0.gguf" }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_8b_fp4mixed.safetensors",
      "type": "flux2",
      "device": "default"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "flux2-vae.safetensors" }
  },
  "positive": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["clip", 0], "text": "{PROMPT}" }
  },
  "negative": {
    "class_type": "ConditioningZeroOut",
    "inputs": { "conditioning": ["positive", 0] }
  },
  "latent": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": { "width": "{WIDTH}", "height": "{HEIGHT}", "batch_size": 1 }
  },
  "sigmas": {
    "class_type": "Flux2Scheduler",
    "inputs": { "steps": 4, "width": "{WIDTH}", "height": "{HEIGHT}" }
  },
  "guider": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": ["unet", 0],
      "positive": ["positive", 0],
      "negative": ["negative", 0],
      "cfg": 1.0
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": "{SEED}" }
  },
  "sampler_select": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "euler" }
  },
  "sampler": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["noise", 0],
      "guider": ["guider", 0],
      "sampler": ["sampler_select", 0],
      "sigmas": ["sigmas", 0],
      "latent_image": ["latent", 0]
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["sampler", 0], "vae": ["vae", 0] }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": { "images": ["decode", 0], "filename_prefix": "loomcast_klein" }
  }
}
